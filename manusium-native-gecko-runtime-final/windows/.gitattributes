# .gitattributes - keep Windows script line endings stable.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.vbs  text eol=crlf
*.ps1  text eol=crlf
*.iss  text eol=crlf
*.ico  binary
*.png  binary

# Cross-platform source inspections must see stable text on Windows too.
*.ts text eol=lf
*.mts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml text eol=lf
